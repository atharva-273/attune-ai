    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
